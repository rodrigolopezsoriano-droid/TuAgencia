---
import Base from '../../layouts/Base.astro';
import CtaFinal from '../../components/CtaFinal.astro';
import { SOLUCIONES, getSolucion } from '../../data/soluciones';
import { SECTORES } from '../../data/sectores';

export function getStaticPaths() {
  return SOLUCIONES.map((s) => ({ params: { slug: s.slug } }));
}
const s = getSolucion(Astro.params.slug!)!;
const sectores = SECTORES.filter((x) => x.soluciones.includes(s.slug));
const otras = SOLUCIONES.filter((x) => x.slug !== s.slug).slice(0, 3);
const ld = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: s.nombre,
  description: s.resumen,
  provider: { '@id': 'https://tuagencia.tech/#empresa' },
  areaServed: ['Alcalá de Henares', 'Madrid', 'España'],
};
---
<Base title={s.seo.title} description={s.seo.description} jsonLd={ld}>
  <section class="section center hero">
    <div class="wrap stack">
      <div class="icon-badge big reveal">{s.icono}</div>
      <p class="eyebrow reveal">{s.nombre}</p>
      <h1 class="display reveal reveal-d1">{s.corto}</h1>
      <p class="lead reveal reveal-d2">{s.resumen}</p>
      <div class="actions reveal reveal-d3" style="margin-top:36px">
        <a href={`/contacto?solucion=${s.slug}`} class="btn btn-primary">Quiero una demo gratis</a>
        <a href="/precios" class="btn btn-ghost">Plan {s.plan} →</a>
      </div>
    </div>
  </section>

  <section class="section-tight soft">
    <div class="wrap grid g2">
      <div class="card reveal">
        <h2 class="h3" style="margin-bottom:20px">Qué hace</h2>
        <ul class="list-check">{s.queHace.map((x) => <li>{x}</li>)}</ul>
      </div>
      <div class="card reveal reveal-d1">
        <h2 class="h3" style="margin-bottom:20px">Para quién</h2>
        <ul class="list-check">{s.paraQuien.map((x) => <li>{x}</li>)}</ul>
        <p class="result"><strong>Resultado:</strong> {s.resultado}</p>
      </div>
    </div>
  </section>

  {sectores.length > 0 && (
    <section class="section-tight">
      <div class="wrap center">
        <p class="muted">Lo usamos sobre todo en</p>
        <div class="chips">{sectores.map((x) => <a class="chip" href={`/sectores/${x.slug}`}>{x.nombre}</a>)}</div>
      </div>
    </section>
  )}

  <section class="section-tight soft">
    <div class="wrap">
      <h2 class="h3 center" style="margin-bottom:28px">Combínalo con</h2>
      <div class="grid g3">
        {otras.map((o) => (
          <a href={`/soluciones/${o.slug}`} class="card card-link">
            <div class="icon-badge">{o.icono}</div>
            <h3 class="h3">{o.nombre}</h3>
            <p class="muted" style="margin:6px 0 0">{o.corto}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CtaFinal />
</Base>

<style>
  .hero { padding-bottom: 64px; }
  .icon-badge.big { width: 72px; height: 72px; font-size: 2.1rem; border-radius: 20px; margin: 0 auto 8px; }
  .result { margin: 24px 0 0; padding-top: 20px; border-top: 1px solid var(--line); }
  .chips { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: 16px; }
  .chip { padding: 10px 18px; border-radius: 999px; background: var(--bg-soft); font-weight: 550; }
</style>
