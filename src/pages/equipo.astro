---
import Base from '../layouts/Base.astro';
import CtaFinal from '../components/CtaFinal.astro';
import Avatar from '../components/Avatar.astro';
import { EQUIPO } from '../data/site';
---
<Base title="Equipo" description="Somos TuAgencia: tres personas de Alcalá de Henares que montan automatizaciones para negocios locales.">
  <section class="section center">
    <div class="wrap stack">
      <h1 class="display reveal">Hablas con quien lo construye.</h1>
      <p class="lead reveal reveal-d1">Somos tres personas de Alcalá de Henares y montamos TuAgencia para que los negocios de nuestro barrio tengan la misma tecnología que las grandes empresas.</p>
    </div>
  </section>
  <section class="section-tight soft">
    <div class="wrap grid g3">
      {EQUIPO.map((m, i) => (
        <article class:list={['card center reveal', `reveal-d${i + 1}`]}>
          <Avatar foto={m.foto} inicial={m.inicial} nombre={m.nombre} tam={104} />
          <h2 class="h3">{m.nombre}</h2>
          {m.rol && <p class="muted" style="margin:6px 0 0">{m.rol}</p>}
        </article>
      ))}
    </div>
  </section>
  <section class="section">
    <div class="wrap grid g3 valores">
      <div><h3 class="h3">Sin humo</h3><p class="muted">Si algo no te va a ahorrar tiempo, te lo decimos. Preferimos un cliente contento a una venta.</p></div>
      <div><h3 class="h3">Cerca de ti</h3><p class="muted">Estamos en Alcalá y Madrid. Si hace falta, vamos a tu negocio.</p></div>
      <div><h3 class="h3">Tus datos, seguros</h3><p class="muted">Seguridad, copias de seguridad y RGPD van de serie.</p></div>
    </div>
  </section>
  <CtaFinal />
</Base>
<style>
  .valores > div > * + * { margin-top: 10px; }
</style>
