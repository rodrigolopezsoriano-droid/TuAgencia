---
import Base from '../../layouts/Base.astro';
import CtaFinal from '../../components/CtaFinal.astro';
import { CASO_BARBERIA_CENSURADO as CASO_CENSURADO, CASO_BARBERIA_NOMBRE as CASO_NOMBRE } from '../../data/casos';

// Seguridad: sin nombre configurado, la página es siempre anónima y con fotos difuminadas.
// Para cambiar de modo: npm run descensurar -- barberia / npm run censurar -- barberia (ver src/data/casos.ts).
const censurado = CASO_CENSURADO || !CASO_NOMBRE;
const fotos = [
  { src: '/casos/barberia/foto-1.webp', alt: 'El barbero en su local' },
  { src: '/casos/barberia/foto-2.webp', alt: 'Corte fade con diseño lateral' },
  { src: '/casos/barberia/foto-3.webp', alt: 'Corte mohicano' },
  { src: '/casos/barberia/foto-4.webp', alt: 'Corte mullet' },
  { src: '/casos/barberia/foto-5.webp', alt: 'Taper fade visto por detrás' },
];
const altAnonimo = 'Foto difuminada de un trabajo de la barbería';
const bloques = [
  { t: 'Reservas online 24/7', d: 'El cliente elige servicio, barbero y hora. Si pide "cualquier barbero", el sistema asigna el que esté libre. La base de datos impide que se solapen dos citas.' },
  { t: 'Cambiar o cancelar sin llamar', d: 'Hasta 2 horas antes, desde su cuenta. Pasado ese margen, la web le redirige a WhatsApp.' },
  { t: 'Club VIP por niveles', d: 'Cada corte completado suma. Cinco niveles, de Bronce a Platinum, con descuentos que el equipo ve al atender.' },
  { t: 'Panel de gestión', d: 'Agenda del día, citas manuales, clientes y resumen del negocio, actualizado en tiempo real.' },
  { t: 'Calendario en el móvil', d: 'Cada barbero se suscribe a su agenda desde el iPhone o Google Calendar y la tiene siempre al día.' },
  { t: 'Bilingüe y con modo oscuro', d: 'Español e inglés, modo claro y oscuro, y animaciones cuidadas que respetan la accesibilidad.' },
];
---
<Base
  title={censurado ? 'Caso de éxito: barbería en Alcalá de Henares con reservas online' : `Caso de éxito: ${CASO_NOMBRE}, reservas online en Alcalá de Henares`}
  description={`Cómo diseñamos para ${censurado ? 'una barbería de Alcalá de Henares' : CASO_NOMBRE} una web con reservas online, club VIP y panel de gestión sincronizado con el calendario.`}
>
  <section class="section center">
    <div class="wrap stack">
      <p class="eyebrow reveal">Caso real · {censurado ? 'Barbería en Alcalá de Henares' : `${CASO_NOMBRE} · Alcalá de Henares`}</p>
      <h1 class="display reveal reveal-d1">Una barbería que reserva sola.</h1>
      <p class="lead reveal reveal-d2">Las citas llegaban por WhatsApp a cualquier hora y se apuntaban a mano. Diseñamos un sistema completo para que los clientes reserven solos y el equipo solo tenga que cortar.</p>
    </div>
  </section>
  <section class="section-tight soft">
    <div class="wrap">
      <div class="stack-tech card reveal">
        <span><b>Frontend</b> React + Vite + Tailwind</span>
        <span><b>Backend</b> Node.js + Express</span>
        <span><b>Base de datos</b> PostgreSQL</span>
        <span><b>Extras</b> Calendario .ics, i18n, modo oscuro</span>
      </div>
      <div class="grid g3" style="margin-top:20px">
        {bloques.map((b, i) => (
          <div class:list={['card reveal', `reveal-d${(i % 3) + 1}`]}>
            <h2 class="h3">{b.t}</h2>
            <p class="muted" style="margin:10px 0 0">{b.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  <section class="section-tight">
    <div class="wrap">
      <h2 class="h3 center reveal">El trabajo, en imágenes</h2>
      <div class="fotos">
        {fotos.map((f, i) => (
          <figure class:list={['reveal', `reveal-d${(i % 3) + 1}`]}>
            <img src={f.src} alt={censurado ? altAnonimo : f.alt} loading="lazy" width="400" height="500" />
          </figure>
        ))}
      </div>
      {censurado && <p class="muted center nota">Imágenes difuminadas para proteger la privacidad del cliente.</p>}
    </div>
  </section>
  <CtaFinal titulo="¿Tienes una peluquería o un centro de estética?" texto="Montamos el mismo sistema adaptado a tu negocio. Pide una demo y te lo enseñamos funcionando." />
</Base>
<style>
  .stack-tech { display: flex; flex-wrap: wrap; gap: 12px 32px; justify-content: center; font-size: 0.95rem; color: var(--muted); }
  .stack-tech b { color: var(--ink); margin-right: 6px; }
  .fotos { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 14px; margin-top: 28px; }
  .fotos figure { margin: 0; border-radius: var(--radius-sm); overflow: hidden; background: var(--bg-soft); aspect-ratio: 4 / 5; }
  .fotos img { width: 100%; height: 100%; object-fit: cover; }
  .nota { margin: 16px 0 0; font-size: 0.9rem; }
</style>
