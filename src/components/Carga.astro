---
// Pantalla de carga: el logo se dibuja con su trazo y gira suavemente en 3D hasta quedar de frente.
// Solo aparece en dos casos:
//  · la primera vez que se entra a la web en la sesión;
//  · al pulsar «Inicio» (el logotipo de la cabecera o del pie, enlaces con [data-inicio]).
// Al pulsar cualquier otro enlace NO aparece. Sin JavaScript o con «reducir movimiento» no se muestra.
---
<div id="carga" aria-hidden="true">
  <div class="c-escena">
    <div class="c-logo">
      <svg class="c-sombra" viewBox="0 0 64 64" fill="none">
        <path d="M32 8 L56 52 H44 L32 28 L20 52 H8 Z" stroke="#312e81" stroke-width="2.5" stroke-linejoin="round" />
      </svg>
      <svg class="c-frente" viewBox="0 0 64 64" fill="none">
        <path class="c-trazo" d="M32 8 L56 52 H44 L32 28 L20 52 H8 Z" stroke="#6366F1" stroke-width="2.5" stroke-linejoin="round" />
        <path class="c-trazo c-d" d="M18 40 H46" stroke="#6366F1" stroke-width="2.5" stroke-linecap="round" />
        <circle class="c-punto" cx="32" cy="28" r="3" fill="#6366F1" />
      </svg>
    </div>
  </div>
  <div class="c-pal">TUAGENCIA<span>.</span></div>
</div>

<style is:global>
  #carga {
    position: fixed; inset: 0; z-index: 9999; background: #050508;
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 24px;
    opacity: 0; visibility: hidden; pointer-events: none;
    transition: opacity 0.6s cubic-bezier(0.4, 0, 0.2, 1), visibility 0.6s;
  }
  /* Visible desde el primer pintado: primera visita (aún sin no-pre) o al llegar desde «Inicio» */
  html:not(.no-pre) #carga, html.carga-inicio #carga, #carga.on { opacity: 1; visibility: visible; pointer-events: auto; }
  #carga.on { transition-duration: 0.25s; }
  html:not(.no-pre) #carga:not(.fin), html.carga-inicio #carga:not(.fin) { animation: c-salida 0.6s ease 4.5s forwards; } /* red de seguridad */
  html #carga.fin { opacity: 0; visibility: hidden; pointer-events: none; }
  html.no-js #carga { display: none; }
  @media (prefers-reduced-motion: reduce) { #carga { display: none !important; } }

  /* El toque 3D: el logo llega girado y con perspectiva, y se endereza mientras se dibuja */
  .c-escena { perspective: 600px; }
  .c-logo { position: relative; width: 64px; height: 64px; transform-style: preserve-3d; transform: rotateY(-50deg) rotateX(14deg); }
  .c-logo svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .c-sombra { transform: translateZ(-7px); opacity: 0; filter: blur(0.4px); }
  .c-frente { filter: drop-shadow(0 0 10px rgba(99, 102, 241, 0.35)); }
  .c-trazo { stroke-dasharray: 200; stroke-dashoffset: 200; }
  .c-punto { opacity: 0; }
  .c-pal { font-weight: 700; font-size: 18px; letter-spacing: 0.08em; color: #8887a8; opacity: 0; }
  .c-pal span { color: #6366f1; }

  /* Se reinicia cada vez que se muestra (clase .anim) */
  #carga.anim .c-logo { animation: c-gira 1.3s cubic-bezier(0.22, 1, 0.36, 1) forwards; }
  #carga.anim .c-sombra { animation: c-aparece 0.6s ease 0.5s forwards; }
  #carga.anim .c-trazo { animation: c-dibuja 1s cubic-bezier(0.4, 0, 0.2, 1) 0.1s forwards; }
  #carga.anim .c-d { animation-delay: 0.4s; }
  #carga.anim .c-punto { animation: c-sube 0.3s ease 0.9s forwards; }
  #carga.anim .c-pal { animation: c-sube 0.5s ease 0.8s forwards; }

  @keyframes c-gira { to { transform: rotateY(0deg) rotateX(0deg); } }
  @keyframes c-dibuja { to { stroke-dashoffset: 0; } }
  @keyframes c-aparece { to { opacity: 0.8; } }
  @keyframes c-sube { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }
  @keyframes c-salida { to { opacity: 0; visibility: hidden; } }
</style>

<!-- Arranca la animación antes del primer pintado si la pantalla va a verse -->
<script is:inline>
  (function () {
    var h = document.documentElement, el = document.getElementById('carga');
    if (el && (!h.classList.contains('no-pre') || h.classList.contains('carga-inicio'))) el.classList.add('anim');
  })();
</script>

<script>
  const html = document.documentElement;
  const el = document.getElementById('carga');
  const reducir = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const t0 = performance.now();

  const cargada = new Promise<void>((ok) => (document.readyState === 'complete' ? ok() : addEventListener('load', () => ok(), { once: true })));
  const esperar = (ms: number) => new Promise<void>((ok) => setTimeout(ok, ms));
  // Se ve como mínimo lo que dura la animación del logo (1,3 s) y como máximo 4 s
  const mostrarHasta = () => Promise.race([Promise.all([cargada, esperar(Math.max(0, 1300 - (performance.now() - t0)))]), esperar(4000)]);

  function ocultar() {
    if (!el) return;
    el.classList.add('fin');
    el.classList.remove('on');
    html.classList.add('no-pre');
    html.classList.remove('carga-inicio');
    try { sessionStorage.setItem('ta_pre', '1'); } catch { /* sin almacenamiento */ }
    setTimeout(() => { if (el.classList.contains('fin')) el.classList.remove('anim'); }, 700);
  }

  if (el) {
    if (reducir) {
      try { sessionStorage.setItem('ta_pre', '1'); } catch { /* sin almacenamiento */ }
    } else if (!html.classList.contains('no-pre') || html.classList.contains('carga-inicio')) {
      mostrarHasta().then(ocultar);
    }

    // Solo el botón de inicio (logotipo) vuelve a mostrar la pantalla de carga
    document.addEventListener('click', (e) => {
      if (reducir || e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      const a = (e.target as Element | null)?.closest?.<HTMLAnchorElement>('a[data-inicio]');
      if (!a) return;
      e.preventDefault();
      el.classList.remove('fin', 'anim');
      void el.offsetWidth; // reinicia la animación
      el.classList.add('on', 'anim');
      const destino = new URL(a.href, location.href);
      if (destino.pathname === location.pathname) {
        // Ya estamos en la portada: animación encima, subimos arriba sin saltos y se retira
        setTimeout(() => { scrollTo({ top: 0, behavior: 'instant' as ScrollBehavior }); if (location.hash) history.replaceState(null, '', location.pathname); }, 300);
        setTimeout(ocultar, 1400);
      } else {
        try { sessionStorage.setItem('ta_inicio', String(Date.now())); } catch { /* sin almacenamiento */ }
        setTimeout(() => location.assign(destino.href), 280);
        setTimeout(() => { if (document.visibilityState === 'visible') ocultar(); }, 9000); // por si la navegación no llega a ocurrir
      }
    });

    // Al volver con «atrás» desde la caché no debe quedar encima
    addEventListener('pageshow', (e) => { if ((e as PageTransitionEvent).persisted) ocultar(); });
  }
</script>
