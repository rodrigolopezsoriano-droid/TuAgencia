---
const { titulo = '¿Qué tarea te gustaría no volver a hacer?', texto = 'Cuéntanosla. En 48 horas te enseñamos una demo funcionando sobre tu propio negocio. Sin coste y sin compromiso.' } = Astro.props;
---
<section class="section dark center">
  <div class="wrap stack">
    <h2 class="h2 reveal">{titulo}</h2>
    <p class="lead reveal reveal-d1">{texto}</p>
    <div class="actions reveal reveal-d2" style="margin-top:36px">
      <a href="/contacto" class="btn btn-primary">Pide tu auditoría gratis</a>
      <a href="/precios" class="btn btn-ghost" style="color:#c7d2fe">Ver precios →</a>
    </div>
  </div>
</section>
