---
import Logo from './Logo.astro';
import { SITE } from '../data/site';
import { SOLUCIONES } from '../data/soluciones';
import { SECTORES } from '../data/sectores';
const year = new Date().getFullYear();
---
<footer class="foot">
  <div class="wrap">
    <div class="cols">
      <div class="about">
        <a href="/" class="brand"><Logo size={22} /><span>TuAgencia<span style="color:var(--brand-2)">.</span></span></a>
        <p class="muted">Automatización con IA para negocios locales. Desde {SITE.zona.join(' y ')}, en remoto para toda España.</p>
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        {SITE.whatsapp && <a href={`https://wa.me/${SITE.whatsapp}`} target="_blank" rel="noopener" class="wa-f"><svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M20.5 3.5A11.8 11.8 0 0 0 1.9 17.7L.5 23.5l6-1.6A11.8 11.8 0 0 0 20.5 3.5ZM12 21.3a9.8 9.8 0 0 1-5-1.4l-.4-.2-3.6.9 1-3.5-.2-.4a9.8 9.8 0 1 1 8.2 4.6Zm5.4-7.3c-.3-.2-1.8-.9-2-1s-.5-.1-.7.1-.8 1-1 1.2-.4.2-.7.1a8 8 0 0 1-4-3.5c-.3-.5.3-.5.9-1.6.1-.2 0-.4 0-.5l-.9-2.2c-.2-.6-.5-.5-.7-.5h-.6a1.1 1.1 0 0 0-.8.4 3.4 3.4 0 0 0-1 2.5 5.9 5.9 0 0 0 1.2 3.1 13.4 13.4 0 0 0 5.2 4.6c1.9.8 2.7.9 3.6.7a3.1 3.1 0 0 0 2-1.4 2.5 2.5 0 0 0 .2-1.4c-.1-.1-.3-.2-.6-.3Z"/></svg><span>WhatsApp · {SITE.whatsappVisible}</span></a>}
      </div>
      <div>
        <p class="ft">Soluciones</p>
        {SOLUCIONES.map((s) => <a href={`/soluciones/${s.slug}`}>{s.nombre}</a>)}
      </div>
      <div>
        <p class="ft">Sectores</p>
        {SECTORES.map((s) => <a href={`/sectores/${s.slug}`}>{s.nombre}</a>)}
      </div>
      <div>
        <p class="ft">Agencia</p>
        <a href="/precios">Precios</a>
        <a href="/equipo">Equipo</a>
        <a href="/casos">Casos de éxito</a>
        <a href="/blog">Blog</a>
        <a href="/informe-resenas">Informe gratis de reseñas</a>
        <a href="/contacto">Contacto</a>
        <a href="/area-cliente">Área cliente</a>
        <a href={SITE.instagram} rel="noopener" target="_blank">Instagram</a>
      </div>
    </div>
    <div class="legal">
      <span>© {year} TuAgencia · {SITE.dominio}</span>
      <span><a href="/aviso-legal">Aviso legal</a> · <a href="/privacidad">Privacidad</a> · <a href="/cookies">Cookies</a></span>
    </div>
  </div>
</footer>

<style>
  .foot { background: var(--bg-soft); padding: 64px 0 32px; font-size: 0.85rem; }
  .cols { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 32px; }
  .cols > div { display: grid; gap: 10px; align-content: start; }
  .brand { display: flex; align-items: center; gap: 8px; font-weight: 700; font-size: 1rem; color: var(--ink); }
  .about p { margin: 0; max-width: 32ch; }
  .ft { margin: 0 0 4px; font-size: 0.8rem; font-weight: 600; color: var(--ink); }
  .cols a { color: var(--muted); }
  .cols a.wa-f { display: inline-flex; align-items: center; gap: 8px; color: #166534; font-weight: 600; }
  .cols a.wa-f:hover { color: #14532d; }
  .cols a:hover { color: var(--ink); }
  .legal { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-top: 48px; padding-top: 20px; border-top: 1px solid var(--line); color: var(--muted); }
  @media (max-width: 820px) { .cols { grid-template-columns: 1fr 1fr; } .about { grid-column: 1 / -1; } }
</style>
