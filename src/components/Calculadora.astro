---
// Calculadora de ahorro: sirve de gancho y de primer contacto.
---
<div class="calc card" data-calc>
  <div class="inputs">
    <div class="field">
      <label for="c-horas">Horas a la semana en tareas repetitivas</label>
      <input id="c-horas" type="range" min="2" max="40" value="10" />
      <output data-out="horas">10 h</output>
    </div>
    <div class="field">
      <label for="c-personas">Personas que las hacen</label>
      <input id="c-personas" type="range" min="1" max="10" value="2" />
      <output data-out="personas">2</output>
    </div>
    <div class="field">
      <label for="c-coste">Coste por hora de cada persona</label>
      <input id="c-coste" type="range" min="10" max="60" value="15" step="1" />
      <output data-out="coste">15 €</output>
    </div>
  </div>
  <div class="result">
    <span class="muted">Automatizando el 60 % podrías recuperar</span>
    <strong class="big" data-out="euros">0 €</strong>
    <span class="muted">al mes · <b data-out="horasMes">0</b> horas de tu equipo</span>
    <a href="/contacto?origen=calculadora" class="btn btn-primary" data-cta>Quiero recuperar ese tiempo</a>
    <small class="muted">Estimación orientativa. En la auditoría gratuita lo calculamos con tus datos reales.</small>
  </div>
</div>

<style>
  .calc { display: grid; grid-template-columns: 1.1fr 1fr; gap: 40px; padding: 40px; }
  .inputs { display: grid; gap: 28px; }
  .field { grid-template-columns: 1fr auto; align-items: center; }
  .field label { grid-column: 1 / -1; }
  output { font-weight: 650; font-variant-numeric: tabular-nums; min-width: 56px; text-align: right; color: var(--ink); }
  input[type='range'] { width: 100%; accent-color: var(--brand); height: 28px; }
  .result { background: var(--ink); color: #fff; border-radius: 18px; padding: 32px; display: grid; gap: 8px; align-content: center; text-align: center; }
  .result .muted { color: #a1a1aa; }
  .result b { color: #fff; }
  .big { font-size: clamp(2.6rem, 6vw, 3.8rem); letter-spacing: -0.04em; line-height: 1.1; font-variant-numeric: tabular-nums; background: linear-gradient(100deg, #a5b4fc, #f0abfc); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .result .btn { margin: 16px auto 4px; }
  small { font-size: 0.75rem; }
  @media (max-width: 820px) { .calc { grid-template-columns: 1fr; padding: 24px; gap: 28px; } }
</style>

<script>
  const root = document.querySelector('[data-calc]');
  if (root) {
    const $ = (id: string) => root.querySelector<HTMLInputElement>(id)!;
    const out = (k: string) => root.querySelector<HTMLElement>(`[data-out="${k}"]`)!;
    const fmt = new Intl.NumberFormat('es-ES', { maximumFractionDigits: 0 });
    const calc = () => {
      const h = +$('#c-horas').value, p = +$('#c-personas').value, c = +$('#c-coste').value;
      const horasMes = h * p * 4.33 * 0.6;
      out('horas').textContent = `${h} h`;
      out('personas').textContent = `${p}`;
      out('coste').textContent = `${c} €`;
      out('horasMes').textContent = fmt.format(horasMes);
      out('euros').textContent = `${fmt.format(horasMes * c)} €`;
      root.querySelector<HTMLAnchorElement>('[data-cta]')!.href =
        `/contacto?origen=calculadora&horas=${h}&personas=${p}&ahorro=${Math.round(horasMes * c)}`;
    };
    root.querySelectorAll('input').forEach((i) => i.addEventListener('input', calc));
    calc();
  }
</script>
