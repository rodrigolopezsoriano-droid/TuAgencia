---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/site';

interface Props {
  title: string;
  description?: string;
  lang?: 'es' | 'en';
  altHref?: string; // misma página en el otro idioma
  jsonLd?: object | object[];
  noindex?: boolean;
}
const { title, description = SITE.descripcion, lang = 'es', altHref, jsonLd, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const fullTitle = title.includes('TuAgencia') ? title : `${title} | TuAgencia`;
const ogImage = new URL('/og.png', SITE.url).href;

// Datos estructurados de la empresa (Google y los buscadores con IA los leen)
const org = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${SITE.url}/#empresa`,
  name: 'TuAgencia',
  url: SITE.url,
  logo: `${SITE.url}/icon-512.png`,
  image: ogImage,
  description: SITE.descripcion,
  email: SITE.email,
  areaServed: [
    { '@type': 'City', name: 'Alcalá de Henares' },
    { '@type': 'City', name: 'Madrid' },
    { '@type': 'Country', name: 'España' },
  ],
  knowsAbout: ['Automatización de procesos', 'Inteligencia artificial', 'Chatbots de WhatsApp', 'CRM', 'n8n'],
  sameAs: [SITE.instagram],
  priceRange: '€€',
};
const extra = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const esHref = lang === 'es' ? Astro.url.pathname : altHref ?? '/';
const enHref = lang === 'en' ? Astro.url.pathname : altHref ?? '/en/';
---
<!doctype html>
<html lang={lang} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="alternate" hreflang="es" href={new URL(esHref, SITE.url).href} />
    <link rel="alternate" hreflang="en" href={new URL(enHref, SITE.url).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(esHref, SITE.url).href} />
    <link rel="icon" href="/logo.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="TuAgencia" />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_GB'} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify([org, ...extra])} />
    <script is:inline>document.documentElement.classList.remove('no-js')</script>
  </head>
  <body>
    <a href="#main" class="sr-only">Saltar al contenido</a>
    <Header lang={lang} altHref={lang === 'es' ? enHref : esHref} />
    <main id="main"><slot /></main>
    <Footer />
    {SITE.whatsapp && (
      <a class="wa" href={`https://wa.me/${SITE.whatsapp}`} target="_blank" rel="noopener" aria-label="Escríbenos por WhatsApp">
        <svg viewBox="0 0 24 24" width="26" height="26" fill="#fff" aria-hidden="true"><path d="M20.5 3.5A11.8 11.8 0 0 0 1.9 17.7L.5 23.5l6-1.6A11.8 11.8 0 0 0 20.5 3.5ZM12 21.3a9.8 9.8 0 0 1-5-1.4l-.4-.2-3.6.9 1-3.5-.2-.4a9.8 9.8 0 1 1 8.2 4.6Zm5.4-7.3c-.3-.2-1.8-.9-2-1s-.5-.1-.7.1-.8 1-1 1.2-.4.2-.7.1a8 8 0 0 1-4-3.5c-.3-.5.3-.5.9-1.6.1-.2 0-.4 0-.5l-.9-2.2c-.2-.6-.5-.5-.7-.5h-.6a1.1 1.1 0 0 0-.8.4 3.4 3.4 0 0 0-1 2.5 5.9 5.9 0 0 0 1.2 3.1 13.4 13.4 0 0 0 5.2 4.6c1.9.8 2.7.9 3.6.7a3.1 3.1 0 0 0 2-1.4 2.5 2.5 0 0 0 .2-1.4c-.1-.1-.3-.2-.6-.3Z"/></svg>
      </a>
    )}
    <script>
      // Revelado suave al hacer scroll (respeta "reducir movimiento")
      const els = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }),
          { rootMargin: '0px 0px -8% 0px', threshold: 0.12 }
        );
        els.forEach((el) => io.observe(el));
      } else els.forEach((el) => el.classList.add('is-in'));
    </script>
    <style>
      .wa { position: fixed; right: 20px; bottom: calc(20px + env(safe-area-inset-bottom)); width: 56px; height: 56px; border-radius: 50%; background: #25d366; display: grid; place-items: center; box-shadow: 0 10px 30px rgba(37, 211, 102, 0.4); z-index: 60; transition: transform 0.25s var(--ease); }
      .wa:active { transform: scale(0.94); }
    </style>
  </body>
</html>
