---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Chatbot from '../components/Chatbot.astro';
import { SITE } from '../data/site';

interface Props {
  title: string;
  description?: string;
  lang?: 'es' | 'en';
  altHref?: string; // misma página en el otro idioma
  jsonLd?: object | object[];
  noindex?: boolean;
}
const { title, description = SITE.descripcion, lang = 'es', altHref, jsonLd, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const fullTitle = title.includes('TuAgencia') ? title : `${title} | TuAgencia`;
const ogImage = new URL('/og.png', SITE.url).href;

// Datos estructurados de la empresa (Google y los buscadores con IA los leen)
const org = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${SITE.url}/#empresa`,
  name: 'TuAgencia',
  url: SITE.url,
  logo: `${SITE.url}/icon-512.png`,
  image: ogImage,
  description: SITE.descripcion,
  email: SITE.email,
  telephone: `+${SITE.whatsapp}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Alcalá de Henares', addressRegion: 'Madrid', addressCountry: 'ES' },
  areaServed: [
    { '@type': 'City', name: 'Alcalá de Henares' },
    { '@type': 'City', name: 'Madrid' },
    { '@type': 'City', name: 'Torrejón de Ardoz' },
    { '@type': 'City', name: 'Coslada' },
  ],
  knowsAbout: ['Automatización de procesos', 'Inteligencia artificial', 'Chatbots de WhatsApp', 'CRM'],
  sameAs: [SITE.instagram],
  priceRange: '€€',
};
// Clave donde supabase-js guarda la sesión: sirve para saber, antes de pintar, si hay alguien con sesión iniciada
let claveSb = '';
try { claveSb = `sb-${new URL(import.meta.env.PUBLIC_SUPABASE_URL as string).hostname.split('.')[0]}-auth-token`; } catch { /* sin Supabase */ }
const extra = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const esHref = lang === 'es' ? Astro.url.pathname : altHref ?? '/';
const enHref = lang === 'en' ? Astro.url.pathname : altHref ?? '/en/';
---
<!doctype html>
<html lang={lang} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="alternate" hreflang="es" href={new URL(esHref, SITE.url).href} />
    <link rel="alternate" hreflang="en" href={new URL(enHref, SITE.url).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(esHref, SITE.url).href} />
    <link rel="icon" href="/logo.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="TuAgencia" />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_GB'} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify([org, ...extra])} />
    <script is:inline define:vars={{ claveSb }}>
      document.documentElement.classList.remove('no-js');
      try { if (claveSb && localStorage.getItem(claveSb)) document.documentElement.classList.add('ta-logueado'); } catch (e) {}
      try { if (sessionStorage.getItem('ta_pre') === '1') document.documentElement.classList.add('no-pre'); } catch (e) {}
    </script>
  </head>
  <body>
    <!-- Animación del logo al entrar (una vez por visita) -->
    <div id="preloader" aria-hidden="true">
      <svg class="pl-logo" viewBox="0 0 64 64" fill="none">
        <path class="pl-path" d="M32 8 L56 52 H44 L32 28 L20 52 H8 Z" stroke="#6366F1" stroke-width="2.5" stroke-linejoin="round" />
        <path class="pl-path pl-d" d="M18 40 H46" stroke="#6366F1" stroke-width="2.5" stroke-linecap="round" />
        <circle class="pl-dot" cx="32" cy="28" r="3" fill="#6366F1" />
      </svg>
      <div class="pl-word">TUAGENCIA<span>.</span></div>
    </div>
    <a href="#main" class="sr-only">Saltar al contenido</a>
    <Header lang={lang} altHref={lang === 'es' ? enHref : esHref} />
    <main id="main"><slot /></main>
    <Footer />
    {lang === 'es' && <Chatbot />}
    <script>
      // Preloader: se muestra el logo al menos 1,3 s la primera vez de cada visita
      const pl = document.getElementById('preloader');
      if (pl) {
        if (document.documentElement.classList.contains('no-pre')) pl.remove();
        else {
          const t0 = performance.now();
          const ocultar = () => {
            pl.classList.add('hidden');
            try { sessionStorage.setItem('ta_pre', '1'); } catch {}
            setTimeout(() => pl.remove(), 900);
          };
          const listo = () => setTimeout(ocultar, Math.max(0, 1300 - (performance.now() - t0)));
          document.readyState === 'complete' ? listo() : addEventListener('load', listo, { once: true });
          setTimeout(ocultar, 4000); // por si algo tarda de más
        }
      }
    </script>
    <script>
      // Revelado suave al hacer scroll (respeta "reducir movimiento")
      const els = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }),
          { rootMargin: '0px 0px -8% 0px', threshold: 0.12 }
        );
        els.forEach((el) => io.observe(el));
      } else els.forEach((el) => el.classList.add('is-in'));
    </script>
    <style is:global>
      #preloader {
        position: fixed; inset: 0; z-index: 9999; background: #050508;
        display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 24px;
        transition: opacity 0.7s cubic-bezier(0.4, 0, 0.2, 1), visibility 0.7s;
        animation: pl-salida 0.7s ease 4.5s forwards; /* red de seguridad si el script no llega a ejecutarse */
      }
      #preloader.hidden { opacity: 0; visibility: hidden; pointer-events: none; }
      .pl-logo { width: 64px; height: 64px; }
      .pl-path { stroke-dasharray: 200; stroke-dashoffset: 200; animation: pl-dibuja 1s cubic-bezier(0.4, 0, 0.2, 1) 0.1s forwards; }
      .pl-d { animation-delay: 0.4s; }
      .pl-dot { opacity: 0; animation: pl-sube 0.3s ease 0.9s forwards; }
      .pl-word { font-weight: 700; font-size: 18px; letter-spacing: 0.08em; color: #8887a8; opacity: 0; animation: pl-sube 0.5s ease 0.8s forwards; }
      .pl-word span { color: #6366f1; }
      @keyframes pl-dibuja { to { stroke-dashoffset: 0; } }
      @keyframes pl-sube { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }
      @keyframes pl-salida { to { opacity: 0; visibility: hidden; } }
      html.no-js #preloader, html.no-pre #preloader { display: none; }
      @media (prefers-reduced-motion: reduce) { #preloader { display: none; } }
    </style>
    <style>
      main { padding-bottom: 0; }
      @media (max-width: 900px) { main { padding-bottom: 72px; } } /* deja sitio a los botones flotantes */
    </style>
  </body>
</html>
