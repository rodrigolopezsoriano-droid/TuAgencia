---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Chatbot from '../components/Chatbot.astro';
import Carga from '../components/Carga.astro';
import { SITE } from '../data/site';

interface Props {
  title: string;
  description?: string;
  lang?: 'es' | 'en';
  altHref?: string; // misma página en el otro idioma
  jsonLd?: object | object[];
  noindex?: boolean;
}
const { title, description = SITE.descripcion, lang = 'es', altHref, jsonLd, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const fullTitle = title.includes('TuAgencia') ? title : `${title} | TuAgencia`;
const ogImage = new URL('/og.png', SITE.url).href;

// Datos estructurados de la empresa (Google y los buscadores con IA los leen)
const org = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${SITE.url}/#empresa`,
  name: 'TuAgencia',
  url: SITE.url,
  logo: `${SITE.url}/icon-512.png`,
  image: ogImage,
  description: SITE.descripcion,
  email: SITE.email,
  telephone: `+${SITE.whatsapp}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Alcalá de Henares', addressRegion: 'Madrid', addressCountry: 'ES' },
  areaServed: [
    { '@type': 'City', name: 'Alcalá de Henares' },
    { '@type': 'City', name: 'Madrid' },
    { '@type': 'City', name: 'Torrejón de Ardoz' },
    { '@type': 'City', name: 'Coslada' },
  ],
  knowsAbout: ['Automatización de procesos', 'Inteligencia artificial', 'Chatbots de WhatsApp', 'CRM'],
  sameAs: [SITE.instagram],
  priceRange: '€€',
};
// Clave donde supabase-js guarda la sesión: sirve para saber, antes de pintar, si hay alguien con sesión iniciada
let claveSb = '';
try { claveSb = `sb-${new URL(import.meta.env.PUBLIC_SUPABASE_URL as string).hostname.split('.')[0]}-auth-token`; } catch { /* sin Supabase */ }
const extra = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const esHref = lang === 'es' ? Astro.url.pathname : altHref ?? '/';
const enHref = lang === 'en' ? Astro.url.pathname : altHref ?? '/en/';
---
<!doctype html>
<html lang={lang} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="alternate" hreflang="es" href={new URL(esHref, SITE.url).href} />
    <link rel="alternate" hreflang="en" href={new URL(enHref, SITE.url).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(esHref, SITE.url).href} />
    <link rel="icon" href="/logo.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="TuAgencia" />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_GB'} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify([org, ...extra])} />
    <script is:inline define:vars={{ claveSb }}>
      document.documentElement.classList.remove('no-js');
      try { if (claveSb && localStorage.getItem(claveSb)) document.documentElement.classList.add('ta-logueado'); } catch (e) {}
      try {
        var h = document.documentElement, ss = sessionStorage;
        if (ss.getItem('ta_pre') === '1') h.classList.add('no-pre'); // ya se vio la intro en esta visita
        var n = +ss.getItem('ta_nav'); // venimos de pulsar un enlace de la propia web: la pantalla de carga sigue puesta
        if (n && Date.now() - n < 6000) h.classList.add('carga-nav');
        ss.removeItem('ta_nav');
      } catch (e) {}
    </script>
  </head>
  <body>
    <Carga />
    <div id="progreso" aria-hidden="true"></div>
    <a href="#main" class="sr-only">Saltar al contenido</a>
    <Header lang={lang} altHref={lang === 'es' ? enHref : esHref} />
    <main id="main"><slot /></main>
    <Footer />
    {lang === 'es' && <Chatbot />}
    <script>
      import '../scripts/animaciones';
    </script>
    <script>
      // Revelado suave al hacer scroll (respeta "reducir movimiento")
      const els = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }),
          { rootMargin: '0px 0px -8% 0px', threshold: 0.12 }
        );
        els.forEach((el) => io.observe(el));
      } else els.forEach((el) => el.classList.add('is-in'));
    </script>
    <style>
      main { padding-bottom: 0; }
      @media (max-width: 900px) { main { padding-bottom: 72px; } } /* deja sitio a los botones flotantes */
    </style>
  </body>
</html>
