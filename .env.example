# Copia este archivo como .env y rellénalo con los datos de tu proyecto de Supabase
# (Supabase > Project Settings > API). La clave "anon" es pública: puede ir en la web.
PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Opcional: captcha gratis de Cloudflare Turnstile para proteger /reservar de bots.
# Clave pública (la de la web). La clave secreta va en Cloudflare como TURNSTILE_SECRET.
PUBLIC_TURNSTILE_SITEKEY=
